# =============================================================================
# Nudge configuration
#
# Copy this file to `.env` in the repository root and edit it:
#
#     cp .env.example .env
#
# The same file configures every way of running Nudge:
#   - Docker production stack (compose.yaml) reads it with `env_file`.
#   - Docker development stack (compose.dev.yaml) reads it if it exists.
#   - Running Django directly (`uv run python manage.py ...`) reads it from the
#     repository root.
#   - The Vite dev server reads the NUDGE_DEV_* and NUDGE_WEB_* values.
#
# How to read this file:
#   - Lines that are NOT commented out must be set. Nudge refuses to start
#     without them in production.
#   - Commented-out lines show the default value. Uncomment a line only to
#     change it.
#   - Booleans accept true/false (also on/off, yes/no, 1/0).
#   - Lists are comma-separated, without spaces: a.example,b.example
#
# Never commit `.env`. It holds secrets and is already in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Debug mode shows detailed error pages and relaxes security checks.
# NEVER enable it on a server reachable by other people.
# The development stack (compose.dev.yaml) turns it on for you.
# NUDGE_DEBUG=false

# Secret used to sign sessions, CSRF tokens and password-reset links.
# Required unless NUDGE_DEBUG=true. Use a long random value and keep it private.
# Changing it signs everyone out.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
NUDGE_SECRET_KEY=

# The address people type into their browser, including the scheme and no
# trailing slash. NUDGE_ALLOWED_HOSTS and NUDGE_CSRF_TRUSTED_ORIGINS default
# to values derived from it, so most deployments only set this.
# Example: https://nudge.example.com
NUDGE_PUBLIC_URL=http://localhost:8000

# Host names Django will answer for. Requests with any other Host header are
# rejected, which blocks host-header attacks.
# Default: the host from NUDGE_PUBLIC_URL, plus localhost and 127.0.0.1.
# Keep `localhost` in the list if you set this: the Docker health check
# uses it.
# NUDGE_ALLOWED_HOSTS=nudge.example.com,localhost,127.0.0.1

# Origins (scheme + host [+ port]) allowed to send forms and API writes.
# Default: the origin of NUDGE_PUBLIC_URL.
# NUDGE_CSRF_TRUSTED_ORIGINS=https://nudge.example.com


# -----------------------------------------------------------------------------
# Web server (Gunicorn in production, runserver in development)
# -----------------------------------------------------------------------------

# Address and port the web server listens on. Both Docker stacks use the
# host's network, so this is an address on the host itself. Point your
# reverse proxy (Caddy) here.
# Use 127.0.0.1 when the proxy runs on the same machine; use a LAN address
# (for example 192.168.1.10) when the proxy reaches Nudge over the network.
# NUDGE_WEB_HOST=127.0.0.1
# NUDGE_WEB_PORT=8000

# Gunicorn worker processes. A good start is 2 x CPU cores; each uses about
# 60-100 MB of memory.
# NUDGE_WEB_WORKERS=2

# Threads per worker process. Requests mostly wait on the database, so a few
# threads per process raise throughput cheaply.
# NUDGE_WEB_THREADS=4

# Seconds a request may run before Gunicorn restarts the worker handling it.
# NUDGE_WEB_TIMEOUT=30

# Comma-separated IPs whose X-Forwarded-* headers Gunicorn trusts. Set it to
# the address your reverse proxy connects from.
# NUDGE_FORWARDED_ALLOW_IPS=127.0.0.1

# Run database migrations when the web container starts. Turn off if you
# prefer to run `python manage.py migrate` yourself during deploys.
# NUDGE_RUN_MIGRATIONS=true


# -----------------------------------------------------------------------------
# Reverse proxy and HTTPS
#
# Nudge is designed to sit behind a reverse proxy (such as Caddy) that
# handles HTTPS. These settings tell Django how to trust it.
# -----------------------------------------------------------------------------

# Trust X-Forwarded-Proto and X-Forwarded-Host from the proxy, so Django
# knows the original request used HTTPS. Turn on behind a proxy; leave off
# when Nudge is reached directly, or clients could fake these headers.
# NUDGE_TRUST_PROXY_HEADERS=false

# Number of proxies in front of Nudge. Rate limits use it to find the real
# client IP in X-Forwarded-For.
# Default: 1 when NUDGE_TRUST_PROXY_HEADERS=true, otherwise 0.
# NUDGE_NUM_PROXIES=0

# Redirect plain HTTP requests to HTTPS. Usually the proxy does this already
# (Caddy does by default), so leave it off to avoid redirect loops.
# NUDGE_SECURE_SSL_REDIRECT=false

# HTTP Strict Transport Security: how many seconds browsers should refuse
# plain HTTP for this site. Caddy can set this header instead. Start small
# (3600) and raise to 31536000 (a year) once HTTPS works reliably, because
# browsers remember it.
# NUDGE_SECURE_HSTS_SECONDS=0
# NUDGE_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# NUDGE_SECURE_HSTS_PRELOAD=false

# Send session and CSRF cookies only over HTTPS.
# Default: true, unless NUDGE_DEBUG=true. Turn off only if you serve Nudge
# over plain HTTP on a trusted network.
# NUDGE_SECURE_COOKIES=true


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
#
# Nudge uses a PostgreSQL server on the host. Create the role and database
# once (the role needs CREATEDB only to run the test suite):
#
#   sudo -u postgres psql -c "CREATE ROLE nudge LOGIN PASSWORD 'change-me' CREATEDB;"
#   sudo -u postgres psql -c "CREATE DATABASE nudge OWNER nudge;"
# -----------------------------------------------------------------------------

# Connection URL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Containers use the host's network, so `localhost` reaches the host's
# PostgreSQL. URL-encode special characters in the password (@ is %40).
DATABASE_URL=postgres://nudge:nudge@localhost:5432/nudge

# Seconds to keep a database connection open between requests. 0 closes it
# after every request; higher values save connection setup time.
# NUDGE_DB_CONN_MAX_AGE=60

# Check that a reused connection still works before using it, so a database
# restart doesn't cause errors.
# NUDGE_DB_CONN_HEALTH_CHECKS=true


# -----------------------------------------------------------------------------
# Accounts and sign-in
#
# There is no public sign-up. Create accounts with:
#   docker compose exec web python manage.py createsuperuser
# or in the Django admin.
# -----------------------------------------------------------------------------

# How long a sign-in lasts, in seconds. Default: 14 days.
# NUDGE_SESSION_COOKIE_AGE=1209600

# Minimum password length for new and changed passwords.
# NUDGE_PASSWORD_MIN_LENGTH=10

# Sign-in attempts allowed per client IP, and password change attempts per
# user, as count/period. Periods: s, m, h, d.
# NUDGE_LOGIN_RATE_LIMIT=10/m

# Calendar feed fetches allowed per client IP, as count/period. Calendar apps
# refresh a feed every 30 minutes at most, so raise this only if many users'
# calendars fetch through one address (Google and Outlook.com fetch from
# their own servers, so the instance must be reachable from the internet for
# them).
# NUDGE_CALENDAR_FEED_RATE_LIMIT=30/m


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------

# Cache used for rate limiting. The default keeps a separate in-memory cache
# per web worker, so the effective limit is NUDGE_LOGIN_RATE_LIMIT x workers.
# For exact limits, share a cache between workers, for example the database:
#   NUDGE_CACHE_URL=dbcache://nudge_cache
#   (then run once: python manage.py createcachetable)
# NUDGE_CACHE_URL=locmemcache://


# -----------------------------------------------------------------------------
# Attachments
#
# Files people attach to Tasks, on disk or in a bucket. They are never served
# from a public URL; only their owner can download them. Back them up with
# the database.
# -----------------------------------------------------------------------------

# Folder that holds uploaded files. The Docker stack mounts the `media`
# volume here and shares it between web and worker. Leave it at the default
# there: the image prepares only that folder for its unprivileged user, so a
# volume mounted anywhere else isn't writable. Running Nudge without Docker,
# point it at a folder on a disk with room to grow. Big uploads are spooled in
# its `uploads` subfolder while they arrive.
# Default: /app/backend/media in Docker, backend/media in the repository
# otherwise.
# NUDGE_MEDIA_ROOT=/app/backend/media

# Largest file a person can attach, in bytes. Default: 25 MB (26214400).
# Keep your reverse proxy's request body limit a little above it (see
# Caddyfile.example).
# NUDGE_ATTACHMENT_MAX_SIZE=26214400

# Store Attachments in an S3-compatible bucket (Cloudflare R2, Backblaze B2,
# MinIO, Wasabi, AWS S3) instead of NUDGE_MEDIA_ROOT. Setting
# NUDGE_STORAGE_BUCKET switches to the bucket, and the endpoint and both keys
# below are then required: Nudge stops at startup naming any that are
# missing. With none of them set, files stay on disk.
# Files stay private: downloads still go through Nudge, so the bucket needs
# no public access. Keep the `media` volume: big uploads are still spooled
# there while they arrive. For R2, `scripts/setup-r2.sh` walks you through
# creating the bucket and token and fills these in. After switching, copy
# existing files with `python manage.py copy_media_to_storage` and test the
# bucket any time with `python manage.py check_storage`.
# Default: unset (files stay on disk).
# NUDGE_STORAGE_BUCKET=nudge-attachments
# The service's S3 API address. For R2:
# https://<account-id>.r2.cloudflarestorage.com
# NUDGE_STORAGE_ENDPOINT_URL=
# An access key allowed to read, write and delete objects in that bucket.
# Give it access to this bucket only.
# NUDGE_STORAGE_ACCESS_KEY_ID=
# NUDGE_STORAGE_SECRET_ACCESS_KEY=
# The bucket's region. Default: auto, which is what R2 expects. Other
# services need their real region, such as us-east-1.
# NUDGE_STORAGE_REGION=auto


# -----------------------------------------------------------------------------
# Trash
# -----------------------------------------------------------------------------

# Days a deleted Task or Project waits in Trash, where it can be restored,
# before it is deleted for good. Default: 365. Lower it to free disk space
# sooner; raise it to keep deleted work longer.
# NUDGE_TRASH_RETENTION_DAYS=365


# -----------------------------------------------------------------------------
# Admin and API
# -----------------------------------------------------------------------------

# Serve the Django admin, where you create users. Turn off to remove it.
# NUDGE_ADMIN_ENABLED=true

# Path of the admin site, with a trailing slash. Moving it away from the
# well-known `admin/` cuts down on automated login attempts.
# NUDGE_ADMIN_URL=admin/

# Serve interactive API docs at /api/v1/docs and the schema at
# /api/v1/openapi.json.
# NUDGE_API_DOCS_ENABLED=true


# -----------------------------------------------------------------------------
# Language and time
# -----------------------------------------------------------------------------

# Server time zone, used for logs and the admin. Each user's own time zone
# is handled separately. Use an IANA name such as Europe/London.
# NUDGE_TIME_ZONE=UTC

# Language of server-rendered pages (admin, emails).
# NUDGE_LANGUAGE_CODE=en-us


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# Where outgoing email goes, as a URL:
#   consolemail://                                 print to the log (default)
#   smtp://user:password@smtp.example.com:25       plain SMTP
#   smtp+tls://user:password@smtp.example.com:587  SMTP with STARTTLS
#   smtp+ssl://user:password@smtp.example.com:465  SMTP over SSL
#   dummymail://                                   discard everything
# URL-encode special characters in the user and password (@ is %40).
# NUDGE_EMAIL_URL=consolemail://

# Sender address for email from Nudge.
# NUDGE_DEFAULT_FROM_EMAIL=Nudge <nudge@localhost>


# -----------------------------------------------------------------------------
# Push notifications
#
# Web Push sends notifications to browsers and installed apps through each
# browser's own push service; no third-party account is needed. Push stays
# off until both keys are set. Create a key pair once with:
#   docker compose run --rm web python manage.py generate_vapid_keys
# and paste the two lines it prints here. Changing the keys later cuts off
# every device until its owner turns push on again.
#
# Browsers only allow push on HTTPS sites (and on localhost). On iPhone and
# iPad, people must add Nudge to their Home Screen before they can turn it on.
# -----------------------------------------------------------------------------

# NUDGE_VAPID_PUBLIC_KEY=
# NUDGE_VAPID_PRIVATE_KEY=

# How push services can contact whoever runs this server if it misbehaves:
# a mailto: or https: URL. Apple rejects localhost addresses, so set this to
# a real email address when NUDGE_PUBLIC_URL isn't a public https URL.
# Default: NUDGE_PUBLIC_URL.
# NUDGE_VAPID_SUBJECT=mailto:you@example.com


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level for Nudge's own code: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# NUDGE_LOG_LEVEL=INFO

# Log level for Django's internals. Raise to INFO or DEBUG when debugging.
# NUDGE_DJANGO_LOG_LEVEL=WARNING


# -----------------------------------------------------------------------------
# Background worker
# -----------------------------------------------------------------------------

# Background jobs (reminders, emails) the worker runs at the same time.
# NUDGE_WORKER_CONCURRENCY=4


# -----------------------------------------------------------------------------
# Files and paths
#
# The defaults match the repository and the Docker image; change them only
# for a custom layout.
# -----------------------------------------------------------------------------

# Where `collectstatic` gathers static files (admin CSS and JS).
# NUDGE_STATIC_ROOT=backend/staticfiles

# The built React app (output of `npm run build`).
# NUDGE_FRONTEND_DIST_DIR=frontend/dist


# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------

# Which published image (ghcr.io/prabhuakshay/nudge) the production stack
# runs. `latest` is the newest release. Pin a minor version such as 0.2 to
# get its fixes on `docker compose pull` without surprise upgrades, or an
# exact version such as 0.2.1 to roll back by changing one value.
# NUDGE_IMAGE_TAG=latest


# -----------------------------------------------------------------------------
# Development only
# -----------------------------------------------------------------------------

# Address and port of the Vite dev server. Open this in the browser during
# development; it proxies /api, /admin and /static to Django.
# NUDGE_DEV_FRONTEND_HOST=localhost
# NUDGE_DEV_FRONTEND_PORT=5173

# Where Vite sends API requests. Default: http://NUDGE_WEB_HOST:NUDGE_WEB_PORT
# (with localhost when NUDGE_WEB_HOST is unset).
# NUDGE_DEV_BACKEND_URL=http://localhost:8000

# User and group the development containers run as, so files they create
# belong to you. Find yours with `id -u` and `id -g`.
# NUDGE_DEV_UID=1000
# NUDGE_DEV_GID=1000
