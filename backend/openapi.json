{
  "openapi": "3.1.0",
  "info": {
    "title": "Nudge API",
    "version": "1.0.0",
    "description": "HTTP API for Nudge, an open-source, self-hostable task manager."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "apps_core_api_health",
        "summary": "Check service health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        },
        "description": "Report whether the API and its database are working.",
        "tags": [
          "core"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "apps_accounts_api_session",
        "summary": "Get the current session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          }
        },
        "description": "Return the signed-in user, or no user, and set the CSRF cookie the frontend needs.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "apps_accounts_api_login",
        "summary": "Sign in",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Start a session for the user with these credentials.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "apps_accounts_api_logout",
        "summary": "Sign out",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "description": "End the current session.",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "operationId": "apps_accounts_api_password",
        "summary": "Change password",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Change the signed-in user's password, keeping this session and ending all others.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChangeIn"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/profile": {
      "patch": {
        "operationId": "apps_accounts_api_profile",
        "summary": "Update profile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        },
        "description": "Change the signed-in user's name and return the updated user.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileIn"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/time-zone": {
      "put": {
        "operationId": "apps_accounts_api_time_zone",
        "summary": "Set time zone",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        },
        "description": "Change the signed-in user's time zone and return the updated user.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeZoneIn"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/notifications": {
      "get": {
        "operationId": "apps_notifications_api_notifications",
        "summary": "List notifications",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationListOut"
                }
              }
            }
          }
        },
        "description": "Return the user's latest notifications and their unread count.",
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/notifications/{notification_id}/read": {
      "post": {
        "operationId": "apps_notifications_api_mark_read",
        "summary": "Mark a notification as read",
        "parameters": [
          {
            "in": "path",
            "name": "notification_id",
            "schema": {
              "title": "Notification Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Mark one notification as read.",
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/notifications/read-all": {
      "post": {
        "operationId": "apps_notifications_api_mark_all_read",
        "summary": "Mark all as read",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "description": "Mark every notification as read.",
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/notifications/{notification_id}": {
      "delete": {
        "operationId": "apps_notifications_api_dismiss",
        "summary": "Dismiss a notification",
        "parameters": [
          {
            "in": "path",
            "name": "notification_id",
            "schema": {
              "title": "Notification Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Remove one notification from the notification center.",
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/notifications/test": {
      "post": {
        "operationId": "apps_notifications_api_send_test",
        "summary": "Send a test notification",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationOut"
                }
              }
            }
          }
        },
        "description": "Notify the user, to check that notifications reach their devices.",
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/notifications/push": {
      "get": {
        "operationId": "apps_notifications_api_push_config",
        "summary": "Get push settings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushConfigOut"
                }
              }
            }
          }
        },
        "description": "Return the key browsers need to subscribe, if the server has push set up.",
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/notifications/push/subscriptions": {
      "post": {
        "operationId": "apps_notifications_api_subscribe",
        "summary": "Register a browser for push",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "description": "Push the user's notifications to this browser.",
        "tags": [
          "notifications"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushSubscriptionIn"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      },
      "delete": {
        "operationId": "apps_notifications_api_unsubscribe",
        "summary": "Unregister a browser from push",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "description": "Stop pushing the user's notifications to this browser.",
        "tags": [
          "notifications"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushUnsubscribeIn"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOut": {
        "description": "Service health, as reported to load balancers and uptime monitors.",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "SessionOut": {
        "description": "Who is signed in on this browser, if anyone.",
        "properties": {
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "user"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "UserOut": {
        "description": "The signed-in user, as the frontend sees them.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "time_zone": {
            "description": "IANA time zone name, or empty when not set yet.",
            "title": "Time Zone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "full_name",
          "time_zone"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ErrorOut": {
        "description": "A human-readable error message.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "LoginIn": {
        "description": "Credentials submitted from the sign-in form.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "PasswordChangeIn": {
        "description": "The current password, to confirm it's really the user, and the one replacing it.",
        "properties": {
          "current_password": {
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChangeIn",
        "type": "object"
      },
      "ProfileIn": {
        "description": "Profile fields the user can change themselves.",
        "properties": {
          "full_name": {
            "maxLength": 150,
            "title": "Full Name",
            "type": "string"
          }
        },
        "required": [
          "full_name"
        ],
        "title": "ProfileIn",
        "type": "object"
      },
      "TimeZoneIn": {
        "description": "The user's new time zone.",
        "properties": {
          "time_zone": {
            "description": "IANA time zone name, such as Europe/London.",
            "title": "Time Zone",
            "type": "string"
          }
        },
        "required": [
          "time_zone"
        ],
        "title": "TimeZoneIn",
        "type": "object"
      },
      "NotificationListOut": {
        "description": "The latest notifications and how many of all the user's notifications are unread.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NotificationOut"
            },
            "title": "Items",
            "type": "array"
          },
          "unread_count": {
            "title": "Unread Count",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "unread_count"
        ],
        "title": "NotificationListOut",
        "type": "object"
      },
      "NotificationOut": {
        "description": "A notification as the notification center shows it.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "url": {
            "description": "Path in the app to open, or empty.",
            "title": "Url",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "read_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Read At"
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "url",
          "created_at",
          "read_at"
        ],
        "title": "NotificationOut",
        "type": "object"
      },
      "PushConfigOut": {
        "description": "What a browser needs to subscribe to push.",
        "properties": {
          "public_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The server's VAPID public key, or null when push isn't set up.",
            "title": "Public Key"
          }
        },
        "required": [
          "public_key"
        ],
        "title": "PushConfigOut",
        "type": "object"
      },
      "PushKeysIn": {
        "description": "The browser's keys for encrypting pushes to it.",
        "properties": {
          "p256dh": {
            "maxLength": 200,
            "title": "P256Dh",
            "type": "string"
          },
          "auth": {
            "maxLength": 100,
            "title": "Auth",
            "type": "string"
          }
        },
        "required": [
          "p256dh",
          "auth"
        ],
        "title": "PushKeysIn",
        "type": "object"
      },
      "PushSubscriptionIn": {
        "description": "A browser's push subscription, as `PushSubscription.toJSON()` returns it.",
        "properties": {
          "endpoint": {
            "maxLength": 2048,
            "title": "Endpoint",
            "type": "string"
          },
          "keys": {
            "$ref": "#/components/schemas/PushKeysIn"
          }
        },
        "required": [
          "endpoint",
          "keys"
        ],
        "title": "PushSubscriptionIn",
        "type": "object"
      },
      "PushUnsubscribeIn": {
        "description": "The endpoint of the browser to stop pushing to.",
        "properties": {
          "endpoint": {
            "title": "Endpoint",
            "type": "string"
          }
        },
        "required": [
          "endpoint"
        ],
        "title": "PushUnsubscribeIn",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  },
  "servers": []
}