{
  "openapi": "3.1.0",
  "info": {
    "title": "Nudge API",
    "version": "1.0.0",
    "description": "HTTP API for Nudge, an open-source, self-hostable task manager."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "apps_core_api_health",
        "summary": "Check service health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        },
        "description": "Report whether the API and its database are working.",
        "tags": [
          "core"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "apps_accounts_api_session",
        "summary": "Get the current session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          }
        },
        "description": "Return the signed-in user, or no user, and set the CSRF cookie the frontend needs.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "apps_accounts_api_login",
        "summary": "Sign in",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Start a session for the user with these credentials.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "apps_accounts_api_logout",
        "summary": "Sign out",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "description": "End the current session.",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOut": {
        "description": "Service health, as reported to load balancers and uptime monitors.",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "SessionOut": {
        "description": "Who is signed in on this browser, if anyone.",
        "properties": {
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "user"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "UserOut": {
        "description": "The signed-in user, as the frontend sees them.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "full_name"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ErrorOut": {
        "description": "A human-readable error message.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "LoginIn": {
        "description": "Credentials submitted from the sign-in form.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  },
  "servers": []
}